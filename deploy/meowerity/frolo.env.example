# Meowerity-stack environment for deploy/meowerity/docker-compose.yml.
# Copy to `frolo.env`, fill in, and run:
#   docker compose --env-file deploy/meowerity/frolo.env \
#     -f deploy/meowerity/docker-compose.yml up -d

# REQUIRED: pin the image to an explicit released version tag (never :latest).
FROLO_IMAGE=ghcr.io/meowydev/frolo:0.1.0-beta.1

# Bind address. Default 127.0.0.1 (reverse-proxy/tunnel only). Use 0.0.0.0 ONLY
# on a trusted LAN with no proxy in front.
FROLO_BIND=127.0.0.1

# Set to 1 when behind an HTTPS reverse proxy, and list the external hostname(s).
FROLO_BEHIND_TLS=0
FROLO_ALLOWED_ORIGINS=

# --- Real Proxmox/SSH/router automation (OFF by default) --------------------
# Enable ONLY after the real-mode safety validation has been run against your
# own disposable hardware, then select a Proxmox connection in the panel.
FROLO_ENABLE_REAL_MODE=0
FROLO_REAL_SAFETY_TESTS_PASSED=0

# --- Production public license keys (NEVER a private signing key) -----------
# Inline JSON array of PublicVerificationKey, e.g.
#   FROLO_LICENSE_KEYS=[{"keyId":"frolo-prod-1","alg":"ed25519","publicKey":"<base64url-32-bytes>","environment":"production"}]
# or mount a file and point at it:
#   FROLO_LICENSE_DIR=/etc/frolo/license
#   FROLO_LICENSE_KEYS_FILE=/opt/frolo/license/keys.json
FROLO_LICENSE_KEYS=
FROLO_LICENSE_KEYS_FILE=
