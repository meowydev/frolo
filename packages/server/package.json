    "@frolo/providers-guest": "workspace:*",
    "@frolo/providers-router": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.0.4",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.2.0"
  },
  "optionalDependencies": {
    "tar": "^7.4.3"
  },
